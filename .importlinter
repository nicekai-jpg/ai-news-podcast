[importlinter]
root_package = ai_news_podcast
include_external_packages =
    ai_news_podcast

[importlinter:contract:1]
name = Layered architecture

type = layers

layers =
    presentation.cli
    presentation.site_builder
    business.pipeline
    business.events
    data.config
    data.utils_dao
    data.prompts_dao
    data.text_utils_dao

containers =
    ai_news_podcast

[importlinter:contract:2]
name = Pipeline internal dependencies

type = forbidden

source_modules =
    ai_news_podcast.business.pipeline.fetcher_service
    ai_news_podcast.business.pipeline.processor_service
    ai_news_podcast.business.pipeline.podcast_writer_service
    ai_news_podcast.business.pipeline.tts_engine_service
    ai_news_podcast.business.pipeline.dedup_service
    ai_news_podcast.business.pipeline.llm_client_service
    ai_news_podcast.business.pipeline.material_service
    ai_news_podcast.business.pipeline.runner_service

forbidden_modules =
    ai_news_podcast.presentation.cli
    ai_news_podcast.presentation.site_builder

[importlinter:contract:3]
name = Utils should not depend on business logic

type = forbidden

source_modules =
    ai_news_podcast.data.utils_dao
    ai_news_podcast.data.text_utils_dao

forbidden_modules =
    ai_news_podcast.business.pipeline
    ai_news_podcast.presentation.cli
    ai_news_podcast.presentation.site_builder

[importlinter:contract:4]
name = CLI should not depend on site_builder internals

type = forbidden

source_modules =
    ai_news_podcast.presentation.cli.podcast_pipeline_controller
    ai_news_podcast.presentation.cli.podcast_report_controller

forbidden_modules =
    ai_news_podcast.presentation.site_builder
