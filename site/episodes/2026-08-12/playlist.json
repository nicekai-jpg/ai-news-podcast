      }
    },
    {
      "id": 37,
      "host": "A",
      "text": "这就意味着以后咱们普通人也能在没网的情况下用AI助手了是吧？",
      "start": 505.663,
      "duration": 5.703,
      "audios": {
        "professional": "chunk_037_professional.mp3",
        "lively": "chunk_037_lively.mp3"
