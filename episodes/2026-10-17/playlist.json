      "audios": {
        "professional": "chunk_002_professional.mp3"
      },
      "voices": {
        "professional": "host_b_professional"
      }
    },
    {
      "id": 3,
      "host": "A",
      "text": "周航，今天科技圈感觉特别热闹，咱们一条一条慢慢聊哈。",
      "start": 11.916,
      "duration": 4.963,
      "audios": {
