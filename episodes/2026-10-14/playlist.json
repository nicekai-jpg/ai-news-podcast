    },
    {
      "id": 45,
      "host": "A",
      "text": "等等，GPT-6 Astra？我怎么听着像 OpenAI 的命名呢？",
      "start": 547.546,
      "duration": 4.833,
      "audios": {
        "lively": "chunk_045_lively.mp3"
