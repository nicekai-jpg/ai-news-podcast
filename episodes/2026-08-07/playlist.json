      "voices": {
        "professional": "host_b_professional",
        "lively": "host_b_lively"
      }
    },
    {
      "id": 13,
      "host": "A",
      "text": "那你觉得LeCun真的会亲自下场管日常吗？他不像那种爱坐办公室的人吧？",
      "start": 139.319,
      "duration": 8.795,
