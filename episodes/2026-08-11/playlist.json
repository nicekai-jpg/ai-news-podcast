        "professional": "host_a_professional",
        "lively": "host_a_lively"
      }
    },
    {
      "id": 28,
      "host": "B",
      "text": "\"氛围编程\"这个名字我当时第一次听也是愣了一下，英文叫vibe coding。",
      "start": 214.513,
      "duration": 5.312,
      "audios": {
