        "lively": "chunk_031_lively.mp3"
      },
      "voices": {
        "professional": "host_a_professional",
        "lively": "host_a_lively"
      }
    },
    {
      "id": 32,
      "host": "B",
      "text": "你注意啊，规模是35.3万，这还只是Google一家的课程。你想想全球范围内有多少人在尝试这个？劳动力市场真的在变天。",
      "start": 243.09,
      "duration": 10.754,
      "audios": {
