      },
      "voices": {
        "professional": "host_b_professional"
      }
    },
    {
      "id": 53,
      "host": "A",
      "text": "今天给大家推荐一个超有意思的GitHub项目，叫XiaoDuoYa/codex-with-chatgpt，目前已经收获了4048颗星了。",
      "start": 494.476,
