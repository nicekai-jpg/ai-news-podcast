    },
    {
      "id": 2,
      "host": "B",
      "text": "大家好，我是周航。苏晴你这开场词我都快能背下来了。",
      "start": 8.284,
      "duration": 4.049,
      "audios": {
        "professional": "chunk_002_professional.mp3",
